# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — contact form + invoice email delivery
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=example@mail.com
CONTACT_EMAIL=example@mail.com
TO_EMAIL=example@mail.com
# Vercel Cron secret (Vercel sends it as a Bearer token to /api/cron/*)
CRON_SECRET=
SMS_EMAIL=xxxxxxxxxx@msg.telus.com

CLOUDFLARE_SITE_KEY=0x4AAAAAA...
CLOUDFLARE_SECRET_KEY=0x4AAAAAA...
